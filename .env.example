# Database
DB_NAME=library_management
DB_USERNAME=library_user
DB_PASSWORD=library_password
DB_ROOT_PASSWORD=root_password
# Application URLs and ports
FRONTEND_PORT=5173
BACKEND_PORT=5000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Security and initial administrator - change before deployment
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_EMAIL=admin@library.local
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Library Admin

# Optional integrations
GOOGLE_CLIENT_ID=local-client-id
GOOGLE_CLIENT_SECRET=local-client-secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_API_KEY=
GEMINI_API_KEY=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@library.local
NOTIFICATION_ENABLED=false
